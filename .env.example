# Public Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Browser anon key for the legacy jobs dashboard only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key for demo lead generation. Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile (public site key for the widget).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Cloudflare Turnstile secret for server-side verification.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# HMAC secret for hashing client identifiers in the demo rate limiter.
DEMO_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Optional demo rate limit tuning.
DEMO_RATE_LIMIT_MAX_REQUESTS=10
DEMO_RATE_LIMIT_WINDOW_SECONDS=3600
