# Шаблон окружения для локального n8n.
# Скопируйте в .env и замените значения-заглушки. Файл .env в Git не попадает.
#
#   cp .env.example .env

# --- Внутренняя БД n8n (PostgreSQL) --------------------------------------
# Используется только контейнером n8n. К Supabase отношения не имеет.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
# Замените на локальный пароль. Наружу порт БД не публикуется.
N8N_DB_PASSWORD=replace-with-local-password

# --- n8n ------------------------------------------------------------------
# Ключ шифрования credentials. Сгенерируйте случайную строку, например:
#   openssl rand -hex 32
# Смена ключа делает ранее сохранённые credentials нечитаемыми.
N8N_ENCRYPTION_KEY=replace-with-random-32-byte-hex-string

# Часовой пояс для расписаний и логов, например Europe/Berlin или Asia/Almaty.
GENERIC_TIMEZONE=Etc/UTC

# Адрес, на котором n8n отвечает локально.
N8N_HOST=localhost
N8N_PROTOCOL=http

# Базовый URL для webhook-адресов, которые n8n показывает в нодах.
# Пока окружение локальное, достаточно значения ниже.
#
# ВАЖНО: позже, когда Supabase Database Webhook будет вызывать n8n, здесь
# должен стоять публичный HTTPS URL. Supabase — внешний сервис и достучаться
# до localhost на вашей машине не может.
WEBHOOK_URL=http://localhost:5678/
